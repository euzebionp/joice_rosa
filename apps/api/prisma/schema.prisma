generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OlfactiveFamily {
  FLORAL
  AMADEIRADO
  ORIENTAL
  CITRICO
  GOURMAND
  AROMATICO
  FRUTADO
  COURO
}

enum Gender {
  FEMININO
  MASCULINO
  UNISSEX
}

enum Concentration {
  EAU_DE_COLOGNE
  EAU_DE_TOILETTE
  EAU_DE_PARFUM
  PARFUM
  BODY_SPLASH
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum SyncStatus {
  PENDING_SYNC
  SYNCED
  FAILED
  NOT_APPLICABLE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum SyncDirection {
  INBOUND
  OUTBOUND
}

model Product {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  brand           String          @default("Joice Rosa")
  line            String?
  description     String
  olfactiveFamily OlfactiveFamily
  gender          Gender
  concentration   Concentration
  year            Int?
  notesTop        String[]
  notesHeart      String[]
  notesBase       String[]
  status          ProductStatus   @default(DRAFT)
  seoTitle        String?
  seoDescription  String?
  tagplusId       String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  variants        ProductVariant[]
  media           ProductMedia[]

  @@index([status, olfactiveFamily])
  @@index([gender])
}

model ProductVariant {
  id             String         @id @default(cuid())
  productId      String
  sku            String         @unique
  ean            String         @unique
  volumeMl       Int
  priceCents     Int
  compareAtCents Int?
  costCents      Int?
  status         ProductStatus  @default(ACTIVE)
  tagplusId      String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory[]
  orderItems     OrderItem[]

  @@unique([productId, volumeMl])
  @@index([productId])
}

model Inventory {
  id           String         @id @default(cuid())
  variantId    String
  locationCode String
  locationName String
  quantity     Int            @default(0)
  reserved     Int            @default(0)
  updatedAt    DateTime       @updatedAt
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationCode])
  @@index([variantId])
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  url       String
  alt       String
  type      MediaType @default(IMAGE)
  sortOrder Int       @default(0)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  document  String?
  tagplusId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id             String      @id @default(cuid())
  number         String      @unique
  status         OrderStatus @default(PENDING)
  syncStatus     SyncStatus  @default(PENDING_SYNC)
  customerId     String
  subtotalCents  Int
  discountCents  Int         @default(0)
  shippingCents  Int         @default(0)
  totalCents     Int
  currency       String      @default("BRL")
  tagplusId      String?     @unique
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  customer       Customer    @relation(fields: [customerId], references: [id])
  items          OrderItem[]

  @@index([status])
  @@index([syncStatus])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  variantId      String
  sku            String
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OutboxEvent {
  id          String       @id @default(cuid())
  type        String
  aggregateId String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([aggregateId])
}

model SyncLedger {
  id         String        @id @default(cuid())
  entity     String
  localId    String
  externalId String?
  direction  SyncDirection
  status     SyncStatus
  lastError  String?
  syncedAt   DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([entity, localId, direction])
  @@index([externalId])
}
